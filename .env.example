# Copy to .env and source it, or export these directly. All have defaults.

# JOBSEARCH_DB=jobsearch.db
# JOBSEARCH_PROFILE=profile.json
# JOBSEARCH_PROFILE_STORAGE=profile_storage
# JOBSEARCH_COMPANIES=data/companies.yaml

# JOBSEARCH_LLM=ollama          # ollama | llamacpp | anthropic
# A local reasoning model given a generous max_tokens can genuinely need
# several minutes per call -- raise this rather than lowering max_tokens if
# calls are failing with a timeout (watch for upstream logs showing a 499 /
# client-closed-connection at exactly this many seconds).
# JOBSEARCH_LLM_TIMEOUT=600
# OLLAMA_HOST=http://localhost:11434
# JOBSEARCH_OLLAMA_MODEL=llama3.1:8b
# JOBSEARCH_OLLAMA_EMBED_MODEL=nomic-embed-text

# llama.cpp's own server (llama-server), OpenAI-compatible API -- not Ollama.
# Under docker compose, http://host.docker.internal:8080 reaches a server
# running on the Docker host itself; see docker-compose.yml for the two
# connectivity options and their trade-offs.
# JOBSEARCH_LLAMACPP_HOST=http://localhost:8080
#
# If the server is llama-swap (fronting several model configs) rather than a
# bare llama-server, `model` is not decorative -- it is how llama-swap routes
# the request, and it must be a real id from `curl $HOST/v1/models`, not a
# placeholder. Chat and embeddings are always different models there.
# JOBSEARCH_LLAMACPP_MODEL=local
# JOBSEARCH_LLAMACPP_EMBED_MODEL=          # defaults to JOBSEARCH_LLAMACPP_MODEL if unset

# JOBSEARCH_ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=            # only if JOBSEARCH_LLM=anthropic

# Nomic's text embedding models (the documented default above) are trained
# with these task-instruction prefixes and give measurably worse retrieval
# quality without them. Applies to both the ollama and llamacpp backends.
# Blank both out if you switch to an embedding model that doesn't use this
# convention (e.g. one trained without task prefixes). The trailing space in
# each default ("search_query: ", not "search_query:") is significant --
# keep it if you set these explicitly.
# JOBSEARCH_EMBED_QUERY_PREFIX=search_query:
# JOBSEARCH_EMBED_DOCUMENT_PREFIX=search_document:

# JOBSEARCH_RETRIEVER=embeddings  # bm25 | embeddings
# JOBSEARCH_SHORTLIST=60
# JOBSEARCH_THRESHOLD=60
# JOBSEARCH_CONCURRENCY=6

# Adzuna (https://developer.adzuna.com) -- optional. Leave both unset and the
# adzuna source is skipped silently; set both to enable it.
# JOBSEARCH_ADZUNA_APP_ID=
# JOBSEARCH_ADZUNA_APP_KEY=
